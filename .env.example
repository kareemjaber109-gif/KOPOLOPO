# ==== Yelp Dataset Location ====
# Copy this file to ".env" and update the path below to the folder
# that contains the yelp_academic_dataset_*.json files.
#
# If you leave this commented/empty, the project will look for the files
# inside the "./dataset" folder at the project root.

# YELP_DATASET_DIR=C:/path/to/yelp/dataset
# YELP_DATASET_DIR=D:/Datasets/Yelp/yelp_dataset_challenge_academic_dataset/dataset
